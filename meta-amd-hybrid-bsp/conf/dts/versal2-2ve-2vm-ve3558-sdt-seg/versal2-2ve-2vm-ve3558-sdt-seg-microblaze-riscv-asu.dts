/dts-v1/;
/ {
        compatible = "xlnx,rave2";
        model = "AMD Versal Gen 2";
        #address-cells = <0x2>;
        #size-cells = <0x2>;
        interrupt-parent = <&imux>;
        board = "rave2";
        vivado-version = "2026.2.0";
        device_id = "xc2ve3558";
        xlnx,ddrmc5-debug-elf = "false";
        xlnx,ddrmc5-i2c-master = "PMC";
        slrcount = <0x1>;
        family = "Versal_2VE_2VM";
        speed_grade = "2MP";
        pruned-sdt = <0x1>;

        options {

                u-boot {
                        compatible = "u-boot,config";
                        bootscr-address = /bits/ 64 <0x78000000>;
                };
        };

        cpu_opp_table: opp-table {
                phandle = <0x11c>;
                compatible = "operating-points-v2";

                opp-1867000000 {
                        opp-hz = /bits/ 64 <0x6f4828c0>;
                        clock-latency-ns = <0x7a120>;
                        opp-microvolt = <0xf4240>;
                };

                opp-933500000 {
                        opp-hz = /bits/ 64 <0x37a41460>;
                        clock-latency-ns = <0x7a120>;
                        opp-microvolt = <0xf4240>;
                };

                opp-622333333 {
                        opp-hz = /bits/ 64 <0x25180d95>;
                        clock-latency-ns = <0x7a120>;
                        opp-microvolt = <0xf4240>;
                };

                opp-466750000 {
                        opp-hz = /bits/ 64 <0x1bd20a30>;
                        clock-latency-ns = <0x7a120>;
                        opp-microvolt = <0xf4240>;
                };
        };

        cpus_asu: cpus_asu@0 {
                phandle = <0x129>;
                #address-cells = <0x1>;
                #size-cells = <0x0>;
                compatible = "cpus,cluster";
                address-map = <0xf0000000 &amba 0xf0000000 0x10000000>,
                 <0x0 &NoC_C0_C1_C2_C3_ddr_memory 0x0 0x80000000>,
                 <0xedd10000 &mmi_dcdma 0xedd10000 0x1000>,
                 <0xeb310000 &ipi_asu 0xeb310000 0x10000>,
                 <0xbbf00000 &ps_wizard_0_ps11_0_ocm_ram_0_memory 0xbbf00000 0x80000>,
                 <0xbbf80000 &ps_wizard_0_ps11_0_ocm_ram_1_memory 0xbbf80000 0x80000>,
                 <0xbbe00000 &ps_wizard_0_ps11_0_ocm_ram_2_memory 0xbbe00000 0x80000>,
                 <0xbbe80000 &ps_wizard_0_ps11_0_ocm_ram_3_memory 0xbbe80000 0x80000>,
                 <0xa0000000 &ps_wizard_0_mmi_0_mmi_pcie_region_0 0xa0000000 0x10000000>,
                 <0xea460000 &ps_wizard_0_ps11_0_lpd_systmr_read 0xea460000 0x10000>,
                 <0xea470000 &ps_wizard_0_ps11_0_lpd_systmr_ctrl 0xea470000 0x10000>,
                 <0xeaa00000 &ps_wizard_0_ps11_0_ocm_ctrl_3 0xeaa00000 0x10000>,
                 <0xeaa10000 &ps_wizard_0_ps11_0_ocm_xmpu_3 0xeaa10000 0x10000>,
                 <0xeb400000 &ps_wizard_0_ps11_0_ocm_xmpu_0 0xeb400000 0x10000>,
                 <0xeb410000 &ps_wizard_0_ps11_0_lpd_slcr_0 0xeb410000 0x100000>,
                 <0xeb510000 &ps_wizard_0_ps11_0_lpd_slcr_secure_0 0xeb510000 0x40000>,
                 <0xeb5d0000 &ps_wizard_0_ps11_0_ocm_ctrl_0 0xeb5d0000 0x10000>,
                 <0xeb5e0000 &ps_wizard_0_ps11_0_crl_0 0xeb5e0000 0x300000>,
                 <0xeb960000 &ps_wizard_0_ps11_0_ocm_ctrl_1 0xeb960000 0x10000>,
                 <0xeb980000 &ps_wizard_0_ps11_0_ocm_xmpu_1 0xeb980000 0x10000>,
                 <0xeb990000 &ps_wizard_0_ps11_0_lpd_xppu_0 0xeb990000 0x10000>,
                 <0xeb9b0000 &ps_wizard_0_ps11_0_lpd_afi_0 0xeb9b0000 0x10000>,
                 <0xeb9d0000 &ps_wizard_0_ps11_0_ocm_ctrl_2 0xeb9d0000 0x10000>,
                 <0xeb9e0000 &ps_wizard_0_ps11_0_ocm_xmpu_2 0xeb9e0000 0x10000>,
                 <0xeba00000 &r52_0a_atcm_global 0xeba00000 0x10000>,
                 <0xeba10000 &r52_0a_btcm_global 0xeba10000 0x8000>,
                 <0xeba20000 &r52_0a_ctcm_global 0xeba20000 0x8000>,
                 <0xeba40000 &r52_1a_atcm_global 0xeba40000 0x10000>,
                 <0xeba50000 &r52_1a_btcm_global 0xeba50000 0x8000>,
                 <0xeba60000 &r52_1a_ctcm_global 0xeba60000 0x8000>,
                 <0xeba80000 &r52_0b_atcm_global 0xeba80000 0x10000>,
                 <0xeba90000 &r52_0b_btcm_global 0xeba90000 0x8000>,
                 <0xebaa0000 &r52_0b_ctcm_global 0xebaa0000 0x8000>,
                 <0xebac0000 &r52_1b_atcm_global 0xebac0000 0x10000>,
                 <0xebad0000 &r52_1b_btcm_global 0xebad0000 0x8000>,
                 <0xebae0000 &r52_1b_ctcm_global 0xebae0000 0x8000>,
                 <0xebb00000 &r52_0c_atcm_global 0xebb00000 0x10000>,
                 <0xebb10000 &r52_0c_btcm_global 0xebb10000 0x8000>,
                 <0xebb20000 &r52_0c_ctcm_global 0xebb20000 0x8000>,
                 <0xebb40000 &r52_1c_atcm_global 0xebb40000 0x10000>,
                 <0xebb50000 &r52_1c_btcm_global 0xebb50000 0x8000>,
                 <0xebb60000 &r52_1c_ctcm_global 0xebb60000 0x8000>,
                 <0xebb80000 &r52_0d_atcm_global 0xebb80000 0x10000>,
                 <0xebb90000 &r52_0d_btcm_global 0xebb90000 0x8000>,
                 <0xebba0000 &r52_0d_ctcm_global 0xebba0000 0x8000>,
                 <0xebbc0000 &r52_1d_atcm_global 0xebbc0000 0x10000>,
                 <0xebbd0000 &r52_1d_btcm_global 0xebbd0000 0x8000>,
                 <0xebbe0000 &r52_1d_ctcm_global 0xebbe0000 0x8000>,
                 <0xebc00000 &r52_0e_atcm_global 0xebc00000 0x10000>,
                 <0xebc10000 &r52_0e_btcm_global 0xebc10000 0x8000>,
                 <0xebc20000 &r52_0e_ctcm_global 0xebc20000 0x8000>,
                 <0xebc40000 &r52_1e_atcm_global 0xebc40000 0x10000>,
                 <0xebc50000 &r52_1e_btcm_global 0xebc50000 0x8000>,
                 <0xebc60000 &r52_1e_ctcm_global 0xebc60000 0x8000>,
                 <0xebd80000 &ps_wizard_0_ps11_0_sdma_0 0xebd80000 0x10000>,
                 <0xebd90000 &ps_wizard_0_ps11_0_sdma_1 0xebd90000 0x10000>,
                 <0xebda0000 &ps_wizard_0_ps11_0_sdma_2 0xebda0000 0x10000>,
                 <0xebdb0000 &ps_wizard_0_ps11_0_sdma_3 0xebdb0000 0x10000>,
                 <0xebdc0000 &ps_wizard_0_ps11_0_sdma_4 0xebdc0000 0x10000>,
                 <0xebdd0000 &ps_wizard_0_ps11_0_sdma_5 0xebdd0000 0x10000>,
                 <0xebde0000 &ps_wizard_0_ps11_0_sdma_6 0xebde0000 0x10000>,
                 <0xebdf0000 &ps_wizard_0_ps11_0_sdma_7 0xebdf0000 0x10000>,
                 <0xebe8c000 &asu_dma0 0xebe8c000 0x1000>,
                 <0xec200000 &ps_wizard_0_ps11_0_crf_0 0xec200000 0x100000>,
                 <0xec400000 &ps_wizard_0_ps11_0_intfpd_asild_config 0xec400000 0x100000>,
                 <0xec500000 &ps_wizard_0_ps11_0_intfpd_asilb_config 0xec500000 0x100000>,
                 <0xec810000 &ps_wizard_0_ps11_0_fpd_slv_asild_xmpu_0 0xec810000 0x10000>,
                 <0xec820000 &ps_wizard_0_ps11_0_fpd_slv_asilb_xmpu_0 0xec820000 0x10000>,
                 <0xec830000 &ps_wizard_0_ps11_0_fpd_cmn_xmpu 0xec830000 0x10000>,
                 <0xec8c0000 &ps_wizard_0_ps11_0_fpd_slcr_0 0xec8c0000 0x10000>,
                 <0xec8e0000 &ps_wizard_0_ps11_0_fpd_slcr_secure_0 0xec8e0000 0x10000>,
                 <0xec910000 &ps_wizard_0_ps11_0_fpd_systmr_read 0xec910000 0x10000>,
                 <0xec920000 &ps_wizard_0_ps11_0_fpd_systmr_ctrl 0xec920000 0x10000>,
                 <0xecc00000 &ps_wizard_0_ps11_0_apu_0 0xecc00000 0x10000>,
                 <0xecc20000 &ps_wizard_0_ps11_0_fpd_splitter_0 0xecc20000 0x10000>,
                 <0xecd00000 &ps_wizard_0_ps11_0_apu_1 0xecd00000 0x10000>,
                 <0xecd20000 &ps_wizard_0_ps11_0_fpd_splitter_1 0xecd20000 0x10000>,
                 <0xece00000 &ps_wizard_0_ps11_0_apu_2 0xece00000 0x10000>,
                 <0xece20000 &ps_wizard_0_ps11_0_fpd_splitter_2 0xece20000 0x10000>,
                 <0xecf00000 &ps_wizard_0_ps11_0_apu_3 0xecf00000 0x10000>,
                 <0xecf20000 &ps_wizard_0_ps11_0_fpd_splitter_3 0xecf20000 0x10000>,
                 <0xed000000 &gpu 0xed000000 0x800000>,
                 <0xed800000 &ps_wizard_0_mmi_0_mmi_pcie0 0xed800000 0x80000>,
                 <0xed900000 &ps_wizard_0_mmi_0_mmi_gtyp_cfg 0xed900000 0x20000>,
                 <0xed920000 &mmi_10gbe 0xed920000 0x10000>,
                 <0xed930000 &ps_wizard_0_mmi_0_mmi_pipe_gem_slcr 0xed930000 0x1000>,
                 <0x0 &ps_wizard_0_mmi_0_mmi_pcie0_slcr 0x0 0xed939000>,
                 <0xeda00000 &ps_wizard_0_mmi_0_mmi_common 0xeda00000 0x300000>,
                 <0xedd00000 &mmi_dc 0xedd00000 0x10000>,
                 <0xedd10000 &ps_wizard_0_mmi_0_mmi_dpdma 0xedd10000 0x10000>,
                 <0xede00000 &mmi_dptx 0xede00000 0x40000>,
                 <0xede40000 &ps_wizard_0_mmi_0_mmi_usb3phy_crpara 0xede40000 0x40000>,
                 <0xede80000 &ps_wizard_0_mmi_0_mmi_trng 0xede80000 0x10000>,
                 <0xede90000 &ps_wizard_0_mmi_0_mmi_udh_pll 0xede90000 0x10000>,
                 <0xedea0000 &ps_wizard_0_mmi_0_mmi_udh_slcr 0xedea0000 0x10000>,
                 <0xedeb0000 &ps_wizard_0_mmi_0_mmi_hdcp 0xedeb0000 0x8000>,
                 <0xedeb8000 &usb3_dp_phy 0xedeb8000 0x4000>,
                 <0xedebc000 &ps_wizard_0_mmi_0_mmi_usb2phy 0xedebc000 0x4000>,
                 <0xf1020000 &gpio1 0xf1020000 0x10000>,
                 <0xf1110000 &ps_wizard_0_ps11_0_pmc_global_0 0xf1110000 0x50000>,
                 <0xf1220000 &ps_wizard_0_ps11_0_pmc_slave_boot 0xf1220000 0x10000>,
                 <0xf1220000 &ps_wizard_0_mmi_0_pmc_slave_boot 0xf1220000 0x10000>,
                 <0xf1240000 &ps_wizard_0_ps11_0_pmc_efuse_ctrl 0xf1240000 0x10000>,
                 <0xf1250000 &ps_wizard_0_ps11_0_pmc_efuse_cache 0xf1250000 0x10000>,
                 <0xf1260000 &ps_wizard_0_ps11_0_crp_0 0xf1260000 0x10000>,
                 <0xf12a0000 &rtc 0xf12a0000 0x10000>,
                 <0xf1920000 &serial0 0xf1920000 0x10000>,
                 <0xf1930000 &serial1 0xf1930000 0x10000>,
                 <0xf1940000 &i2c0 0xf1940000 0x10000>,
                 <0xf1950000 &i2c1 0xf1950000 0x10000>,
                 <0xf19d0000 &spi1 0xf19d0000 0x10000>,
                 <0xf1a20000 &ps_wizard_0_ps11_0_lpd_iou_slcr_0 0xf1a20000 0x20000>,
                 <0xf1a40000 &ps_wizard_0_ps11_0_lpd_iou_secure_slcr_0 0xf1a40000 0x10000>,
                 <0xf1a50000 &gpio0 0xf1a50000 0x10000>,
                 <0xf2100000 &ps_wizard_0_ps11_0_pmc_slave_boot_stream 0xf2100000 0x10000>,
                 <0xf2100000 &ps_wizard_0_mmi_0_pmc_slave_boot_stream 0xf2100000 0x10000>,
                 <0xf6000000 &ps_wizard_0_ps11_0_pmc_ram_npi 0xf6000000 0x2000000>,
                 <0xebe00000 &ps_wizard_0_ps11_0_asu_ram_instr_cntlr 0xebe00000 0x40000>,
                 <0xebe40000 &ps_wizard_0_ps11_0_asu_ram_data_cntlr 0xebe40000 0x20000>,
                 <0xebe80000 &asu_iomodule0 0xebe80000 0x8000>,
                 <0xebe88000 &ps_wizard_0_ps11_0_asu_aes 0xebe88000 0x2000>,
                 <0xebe8a000 &ps_wizard_0_ps11_0_asu_keys 0xebe8a000 0x2000>,
                 <0xebe8d000 &asu_dma1 0xebe8d000 0x1000>,
                 <0xebe8e000 &ps_wizard_0_ps11_0_asu_local 0xebe8e000 0x2000>,
                 <0xebea0000 &ps_wizard_0_ps11_0_asu_ram_instr_ecc_ctrl 0xebea0000 0x10000>,
                 <0xebeb0000 &ps_wizard_0_ps11_0_asu_ram_data_ecc_ctrl 0xebeb0000 0x10000>,
                 <0xebec0000 &ps_wizard_0_ps11_0_asu_tmr_manager 0xebec0000 0x10000>,
                 <0xebed0000 &ps_wizard_0_ps11_0_asu_tmr_inject 0xebed0000 0x10000>,
                 <0xebee0000 &ps_wizard_0_ps11_0_asu_tmr_trace 0xebee0000 0x10000>,
                 <0xebef0000 &ps_wizard_0_ps11_0_asu_mdm_hsd 0xebef0000 0x10000>,
                 <0xebf00000 &ps_wizard_0_ps11_0_asu_ecc 0xebf00000 0x10000>,
                 <0xebf20000 &ps_wizard_0_ps11_0_asu_trng 0xebf20000 0x10000>,
                 <0xebf30000 &ps_wizard_0_ps11_0_asu_sha2 0xebf30000 0x10000>,
                 <0xebf40000 &ps_wizard_0_ps11_0_asu_sha3 0xebf40000 0x10000>,
                 <0xebf50000 &ps_wizard_0_ps11_0_asu_rsa 0xebf50000 0x10000>,
                 <0xebf60000 &ps_wizard_0_ps11_0_asu_xmpu 0xebf60000 0x10000>,
                 <0xebf70000 &ps_wizard_0_ps11_0_intasu_config 0xebf70000 0xf000>,
                 <0xebf7f000 &ps_wizard_0_ps11_0_intasu_gpv 0xebf7f000 0x1000>,
                 <0xebf80000 &ps_wizard_0_ps11_0_asu_global 0xebf80000 0x20000>;
                #ranges-address-cells = <0x1>;
                #ranges-size-cells = <0x1>;

                asu: cpu@0 {
                        phandle = <0x12a>;
                        compatible = "xlnx,asu-microblaze_riscv";
                        device_type = "cpu";
                        reg = <0x0>;
                        xlnx,d-axi = <0x1>;
                        xlnx,pmp-entries = <0x0>;
                        xlnx,number-of-wr-addr-brk = <0x1>;
                        xlnx,temporal-depth = <0x2>;
                        xlnx,use-interrupt = <0x1>;
                        xlnx,ip-name = "asu";
                        xlnx,optimization = <0x0>;
                        xlnx,async-interrupt = <0x0>;
                        xlnx,interrupt-is-edge = <0x0>;
                        xlnx,pc-width = <0x20>;
                        xlnx,use-mmu = <0x0>;
                        xlnx,m-axi-dp-exclusive-access = <0x1>;
                        xlnx,use-bitman-a = <0x0>;
                        xlnx,use-bitman-b = <0x0>;
                        xlnx,use-bitman-c = <0x0>;
                        xlnx,timestamp-clk-freq = <0x5f5dd19>;
                        xlnx,trace = <0x1>;
                        xlnx,use-config-reset = <0x1>;
                        xlnx,data-size = <0x20>;
                        xlnx,fault-tolerant = <0x0>;
                        xlnx,ill-instr-exception = <0x2>;
                        xlnx,use-sleep = <0x1>;
                        xlnx,d-lmb = <0x1>;
                        clock-frequency = <0x17d77462>;
                        xlnx,m-axi-i-bus-exception = <0x1>;
                        xlnx,use-ext-brk = <0x0>;
                        xlnx,fsl-exception = <0x0>;
                        xlnx,impid = <0x12>;
                        xlnx,use-bitman-s = <0x0>;
                        xlnx,ecc-use-ce-exception = <0x0>;
                        xlnx,base-vectors = <0xebe00000>;
                        xlnx,m-axi-d-bus-exception = <0x1>;
                        xlnx,use-dcache = <0x0>;
                        xlnx,use-muldiv = <0x1>;
                        xlnx,debug-event-counters = <0x0>;
                        xlnx,num-sync-ff-clk-debug = <0x0>;
                        xlnx,use-atomic = <0x1>;
                        xlnx,i-axi = <0x1>;
                        xlnx,cpu-clk-freq-hz = <0x17d77462>;
                        xlnx,num-sync-ff-clk = <0x0>;
                        xlnx,debug-enable = <0x1>;
                        xlnx,debug-latency-counters = <0x0>;
                        xlnx,hartid = <0x0>;
                        xlnx,interconnect = <0x2>;
                        xlnx,num-sync-ff-dbg-clk = <0x0>;
                        xlnx,use-fpu = <0x0>;
                        xlnx,edge-is-positive = <0x1>;
                        xlnx,use-icache = <0x0>;
                        xlnx,async-wakeup = <0x0>;
                        xlnx,number-of-rd-addr-brk = <0x1>;
                        xlnx,use-compression = <0x1>;
                        xlnx,num-sync-ff-trace-clk = <0x0>;
                        xlnx,use-ext-nm-brk = <0x0>;
                        xlnx,i-lmb = <0x1>;
                        timebase-frequency = <0x17d77462>;
                        xlnx,fsl-links = <0x0>;
                        xlnx,num-sync-ff-clk-irq = <0x0>;
                        xlnx,use-branch-target-cache = <0x0>;
                        xlnx,freq = <0x17d77462>;
                        xlnx,number-of-pc-brk = <0x2>;
                        xlnx,imprecise-exceptions = <0x0>;
                };
        };

        aliases {
                serial0 = "/axi/serial@f1920000";
                serial1 = "/axi/serial@f1930000";
                i2c1 = "/axi/i2c@f1940000";
                i2c2 = "/axi/i2c@f1950000";
                spi3 = "/axi/spi@f19d0000";
        };

        firmware {

                psci: psci {
                        phandle = <0x12b>;
                        compatible = "arm,psci-1.0";
                        method = "smc";
                };

                scmi: scmi {
                        phandle = <0x12c>;
                        compatible = "arm,scmi-smc";
                        arm,smc-id = <0xc2002001>;
                        #address-cells = <0x1>;
                        #size-cells = <0x0>;
                        shmem = <0xf8>;
                        bootph-all;

                        scmi_reset: protocol@16 {
                                phandle = <0x104>;
                                reg = <0x16>;
                                #reset-cells = <0x1>;
                        };

                        scmi_devpd: protocol@11 {
                                phandle = <0xd3>;
                                reg = <0x11>;
                                #power-domain-cells = <0x1>;
                        };

                        scmi_clk: protocol@14 {
                                phandle = <0xc5>;
                                reg = <0x14>;
                                #clock-cells = <0x1>;
                        };
                };

                versal2_firmware: versal2-firmware {
                        phandle = <0x12d>;
                        compatible = "xlnx,versal2-firmware";
                        bootph-all;
                        method = "smc";
                        #power-domain-cells = <0x1>;

                        versal_sec_cfg: versal-sec-cfg {
                                phandle = <0x12e>;
                                compatible = "xlnx,versal-sec-cfg";

                                nvmem-layout {
                                        compatible = "fixed-layout";
                                        #address-cells = <0x1>;
                                        #size-cells = <0x1>;

                                        bbram_zeroize: bbram-zeroize@4 {
                                                phandle = <0x12f>;
                                                reg = <0x4 0x4>;
                                        };

                                        bbram_key: bbram-key@10 {
                                                phandle = <0x130>;
                                                reg = <0x10 0x20>;
                                        };

                                        bbram_usr: bbram-usr@30 {
                                                phandle = <0x131>;
                                                reg = <0x30 0x4>;
                                        };

                                        bbram_lock: bbram-lock@48 {
                                                phandle = <0x132>;
                                                reg = <0x48 0x4>;
                                        };

                                        user_key0: user-key@110 {
                                                phandle = <0x133>;
                                                reg = <0x110 0x20>;
                                        };

                                        user_key1: user-key@130 {
                                                phandle = <0x134>;
                                                reg = <0x130 0x20>;
                                        };

                                        user_key2: user-key@150 {
                                                phandle = <0x135>;
                                                reg = <0x150 0x20>;
                                        };

                                        user_key3: user-key@170 {
                                                phandle = <0x136>;
                                                reg = <0x170 0x20>;
                                        };

                                        user_key4: user-key@190 {
                                                phandle = <0x137>;
                                                reg = <0x190 0x20>;
                                        };

                                        user_key5: user-key@1b0 {
                                                phandle = <0x138>;
                                                reg = <0x1b0 0x20>;
                                        };

                                        user_key6: user-key@1d0 {
                                                phandle = <0x139>;
                                                reg = <0x1d0 0x20>;
                                        };

                                        user_key7: user-key@1f0 {
                                                phandle = <0x13a>;
                                                reg = <0x1f0 0x20>;
                                        };
                                };
                        };
                };
        };

        fpga: fpga-region {
                phandle = <0x13b>;
                compatible = "fpga-region";
                fpga-mgr = <&versal_fpga>;
                #address-cells = <0x2>;
                #size-cells = <0x2>;
        };

        timer: timer {
                phandle = <0x13c>;
                compatible = "arm,armv8-timer";
                interrupts = <0x1 0xd 0x4 0x1 0xe 0x4 0x1 0xb 0x4 0x1 0xa 0x4>;
        };

        versal_fpga: versal-fpga {
                phandle = <0xf9>;
                compatible = "xlnx,versal-fpga";
        };

        amba_apu: apu-bus {
                phandle = <0x3>;
                compatible = "simple-bus";
                #address-cells = <0x2>;
                #size-cells = <0x2>;
                ranges;
                u-boot,dm-pre-reloc;
        };

        amba_rpu: rpu-bus {
                phandle = <0xce>;
                compatible = "indirect-bus";
                #address-cells = <0x2>;
                #size-cells = <0x2>;
                ranges;
                u-boot,dm-pre-reloc;
        };

        sensor0: versal-thermal-sensor {
                phandle = <0xfa>;
                compatible = "xlnx,versal-thermal";
                #thermal-sensor-cells = <0x1>;
                io-channel-names = "sysmon-temp-channel";
        };

        thermal-zones {

                versal_thermal: versal-thermal {
                        phandle = <0x13d>;
                        polling-delay-passive = <0xfa>;
                        polling-delay = <0x3e8>;
                        thermal-sensors = <&sensor0 0x0>;

                        trips {

                                temp_alert: temp-alert {
                                        phandle = <0x13e>;
                                        temperature = <0x11170>;
                                        hysteresis = <0x0>;
                                        type = "passive";
                                };

                                ot_crit: ot-crit {
                                        phandle = <0x13f>;
                                        temperature = <0x1e848>;
                                        hysteresis = <0x0>;
                                        type = "critical";
                                };
                        };

                        cooling-maps {
                        };
                };

                versal_thermal_aie: versal-aie-thermal {
                        phandle = <0x140>;
                        polling-delay-passive = <0xfa>;
                        polling-delay = <0x3e8>;
                        thermal-sensors = <&sensor0 0x1>;

                        trips {

                                temp_alert_aie: temp-alert-aie {
                                        phandle = <0x141>;
                                        temperature = <0x11170>;
                                        hysteresis = <0x0>;
                                        type = "passive";
                                };

                                ot_crit_aie: ot-crit-aie {
                                        phandle = <0x142>;
                                        temperature = <0x1e848>;
                                        hysteresis = <0x0>;
                                        type = "critical";
                                };
                        };

                        cooling-maps {
                        };
                };
        };

        amba: axi {
                phandle = <0x2>;
                compatible = "simple-bus";
                bootph-all;
                #address-cells = <0x2>;
                #size-cells = <0x2>;
                ranges;
                interrupt-parent = <&imux>;

                imux: interrupt-multiplex {
                        phandle = <0x1>;
                        compatible = "interrupt-multiplex";
                        #address-cells = <0x0>;
                        #interrupt-cells = <0x3>;
                        interrupt-controller;
                        interrupt-map-mask = <0x0 0xffff 0x0>;
                        interrupt-map = <0x0 &ps_wizard_0_ps11_0_lpd_slcr_secure_0 0x0 0x11 0x0 0x19 &NoC_C0_C1_C2_C3_ddr_memory>,
                         <0x0 0x8f 0x0 0x11 0x0 0x8f &imux>,
                         <0x0 0x90 0x0 0x11 0x0 0x90 &imux>,
                         <0x0 0x93 0x0 0x11 0x0 0x93 &imux>,
                         <0x0 0x94 0x0 0x11 0x0 0x94 &imux>,
                         <0x0 0xa4 0x0 0x11 0x0 0xa4 &imux>,
                         <0x0 0xa5 0x0 0x11 0x0 0xa5 &imux>,
                         <0x0 0x13 0x0 0xd0 0x0 0x13 &NoC_C0_C1_C2_C3_ddr_memory>,
                         <0x0 &ps_wizard_0_ps11_0_sdma_2 0x0 0xd0 0x0 0x4f &NoC_C0_C1_C2_C3_ddr_memory>,
                         <0x0 &ps_wizard_0_ps11_0_lpd_iou_slcr_0 0x0 0xd0 0x0 0xa5 &imux>;
                };

                mmi_gpu_slcr@ed720000 {
                        reg = <0x0 0xed720000 0x0 0x20000>;
                        no-map;
                };

                gpu_physical_memory_group_manager: physical-memory-group-manager {
                        phandle = <0xfe>;
                        compatible = "arm,physical-memory-group-manager";
                };

                gpu: gpu@ed000000 {
                        phandle = <0x6e>;
                        status = "okay";
                        compatible = "arm,mali-ptm";
                        ranges;
                        #address-cells = <0x2>;
                        #size-cells = <0x2>;
                        #interrupt-cells = <0x2>;
                        xlnx,gpu-slices = <0x2>;
                        xlnx,gpu-clk-freq-mhz = <0x5f5e100>;
                        xlnx,gpu-slice0-cores = <0x2>;
                        xlnx,gpu-slice1-cores = <0x2>;
                        xlnx,ip-name = "mmi_gpu";
                        xlnx,gpu-clk-src = "PS_AXI_DMA_CLK";
                        xlnx,name = "ps_wizard_0_mmi_0_mmi_gpu";

                        gpu_interface@ed700000 {
                                compatible = "arm,mali-ptm-interface";
                                ranges = <0x0 0x0 0x0 0xed700000 0x0 0x20000>;
                                reg = <0x0 0xed700000 0x0 0x20000>;
                                #address-cells = <0x2>;
                                #size-cells = <0x2>;

                                gpu_system: gpu_system@0 {
                                        phandle = <0x143>;
                                        compatible = "arm,mali-gpu-system";
                                        reg = <0x0 0x0 0x0 0x10000>;
                                        interrupt-parent = <&imux>;
                                        interrupt-names = "PTM_UNCORRECTED_ERROR_IRQ", "PTM_DEFERRED_ERROR_IRQ";
                                        interrupts = <0x0 0xbc 0x4 0x0 0xbc 0x4>;
                                };

                                gpu_assign: gpu_assign@10000 {
                                        phandle = <0x144>;
                                        compatible = "arm,mali-gpu-assign";
                                        reg = <0x0 0x10000 0x0 0x10000>;
                                };
                        };

                        gpu_interface@ed000000 {
                                compatible = "arm,mali-ptm-interface";
                                ranges = <0x0 0x0 0x0 0xed000000 0x0 0x300000>;
                                reg = <0x0 0xed000000 0x0 0x300000>;
                                #address-cells = <0x2>;
                                #size-cells = <0x2>;

                                gpu_partition_config_a_0: gpu_partition_config@20000 {
                                        phandle = <0xfb>;
                                        compatible = "arm,mali-gpu-partition-config";
                                        reg = <0x0 0x20000 0x0 0x10000>;
                                };

                                gpu_partition_control_a_0: gpu_partition_control@30000 {
                                        phandle = <0xfc>;
                                        compatible = "arm,mali-gpu-partition-control";
                                        reg = <0x0 0x30000 0x0 0x10000>;
                                        interrupt-parent = <&imux>;
                                        interrupt-names = "PTM_PARTITION_IRQ";
                                        interrupts = <0x0 0xb6 0x4>;
                                };

                                gpu_resource_group: gpu_resource_group@a0000 {
                                        phandle = <0x145>;
                                        compatible = "arm,mali-gpu-resource-group";
                                        reg = <0x0 0xa0000 0x0 0x10000>;
                                        partition-config = <&gpu_partition_config_a_0>;
                                        partition-control = <&gpu_partition_control_a_0>;
                                        interrupt-parent = <&imux>;
                                        interrupt-names = "PTM_GROUP_IRQ";
                                        interrupts = <0x0 0xb5 0x4>;
                                };

                                gpu_aw_message_a_0: gpu_aw_message@fffc0 {
                                        phandle = <0xfd>;
                                        compatible = "arm,mali-gpu-aw-message";
                                        reg = <0x0 0xfffc0 0x0 0x40>;
                                        interrupt-parent = <&imux>;
                                        interrupt-names = "PTM_MESSAGE";
                                        interrupts = <0x0 0xb4 0x4>;
                                };

                                gpu_mali: gpu@e0000 {
                                        phandle = <0x146>;
                                        compatible = "arm,mali-midgard";
                                        reg = <0x0 0xe0000 0x0 0x1ffc0>;
                                        interrupt-parent = <&imux>;
                                        interrupt-names = "JOB", "MMU", "GPU";
                                        interrupts = <0x0 0xb4 0x4 0x0 0xb4 0x4 0x0 0xb4 0x4>;
                                        arbiter-if = <&gpu_aw_message_a_0>;
                                        reset-names = "gpu", "gpu_recov";
                                        system-coherency = <0x1f>;
                                        physical-memory-group-manager = <&gpu_physical_memory_group_manager>;
                                        clocks = <&scmi_clk 0x6a>;
                                };
                        };
                };

                mmi_dptx: mmi_dptx@ede00000 {
                        phandle = <0x77>;
